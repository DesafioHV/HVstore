<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HVstore — Perfumería</title>
<style>
:root{
  --bg:#0b0b0b; --bg2:#111; --card:#151515; --line:#262626;
  --txt:#f2f2f0; --muted:#8f8f8c; --accent:#e8e4dc;
  --serif:'Playfair Display',Georgia,'Times New Roman',serif;
  --sans:'Helvetica Neue',Helvetica,Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:var(--sans);}
body{background:var(--bg);color:var(--txt);min-height:100vh;-webkit-font-smoothing:antialiased;}
a{color:inherit;text-decoration:none;}
button{cursor:pointer;font-size:15px;}
::selection{background:var(--accent);color:#000;}

/* ---------- HEADER ---------- */
header{position:sticky;top:0;z-index:50;background:rgba(11,11,11,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);}
.nav{max-width:1150px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:18px 24px;}
.logo{font-family:var(--serif);font-size:24px;font-weight:700;letter-spacing:6px;user-select:none;}
.logo span{color:var(--muted);font-weight:400;}
.nav-links{display:flex;gap:26px;align-items:center;}
.nav-links a{color:var(--muted);font-size:12px;letter-spacing:2px;text-transform:uppercase;transition:.25s;}
.nav-links a:hover{color:var(--white,#fff);}
.search-wrap{position:relative;display:flex;align-items:center;}
.search-ico{position:absolute;left:11px;font-size:12px;opacity:.7;pointer-events:none;}
.search-input{background:#0c0c0c;border:1px solid var(--line);color:var(--txt);padding:9px 12px 9px 32px;font-size:12px;width:190px;border-radius:100px;transition:.25s;}
.search-input:focus{outline:none;border-color:var(--muted);width:240px;}
@media(max-width:640px){.search-input{width:115px;padding:7px 10px 7px 28px;font-size:11px;}.search-input:focus{width:145px;}}
.cat-chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px;}
.chip-f{border:1px solid var(--line);background:var(--card);color:var(--muted);padding:8px 18px;font-size:11px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.25s;}
.chip-f:hover{border-color:var(--muted);color:var(--txt);}
.chip-f.active{background:var(--accent);color:#0b0b0b;border-color:var(--accent);font-weight:700;}
.offer-badge{position:absolute;top:12px;right:12px;background:var(--accent);color:#000;font-size:10px;font-weight:800;letter-spacing:1px;padding:5px 11px;border-radius:100px;}
.old-price{text-decoration:line-through;color:#6f6f6c;font-size:12px;font-weight:400;margin-right:6px;}

/* ---------- HERO ---------- */
main{max-width:1150px;margin:auto;padding:0 24px 90px;}
.hero{text-align:center;padding:80px 20px 30px;}
.hero .eyebrow{font-size:11px;letter-spacing:5px;color:var(--muted);text-transform:uppercase;}
.hero h1{font-family:var(--serif);font-size:clamp(40px,7vw,72px);font-weight:700;letter-spacing:10px;margin:14px 0 10px;}
.hero .line{width:60px;height:1px;background:var(--muted);margin:18px auto;}
.hero p{color:var(--muted);font-size:14px;letter-spacing:1px;line-height:1.8;max-width:460px;margin:0 auto;}
.badge{display:inline-block;margin-top:26px;border:1px solid var(--line);border-radius:100px;padding:9px 22px;font-size:11px;color:var(--muted);letter-spacing:2px;}

/* ---------- SECTIONS ---------- */
.section-title{font-size:11px;letter-spacing:4px;color:var(--muted);text-transform:uppercase;margin:60px 0 24px;display:flex;align-items:center;gap:16px;}
.section-title::after{content:'';flex:1;height:1px;background:var(--line);}

/* ---------- PRODUCT GRID ---------- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:22px;}
.card{background:var(--card);border:1px solid var(--line);overflow:hidden;cursor:pointer;transition:transform .35s,border-color .35s,box-shadow .35s;display:flex;flex-direction:column;}
.card:hover{transform:translateY(-5px);border-color:#4a4a48;box-shadow:0 24px 50px rgba(0,0,0,.5);}
.card-img{aspect-ratio:1/1.1;background:#0e0e0e;position:relative;overflow:hidden;}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s;}
.card:hover .card-img img{transform:scale(1.06);}
.card-img .ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:56px;background:radial-gradient(circle at 50% 35%,#1c1c1c,#0e0e0e);}
.card-img .stock-badge{position:absolute;top:12px;left:12px;background:rgba(11,11,11,.8);backdrop-filter:blur(6px);font-size:10px;letter-spacing:1px;padding:5px 12px;border-radius:100px;color:var(--muted);}
.card-img .stock-badge.out{color:#ff7b7b;border:1px solid rgba(255,123,123,.4);}
.card-body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:6px;flex:1;}
.card-body h3{font-family:var(--serif);font-size:19px;font-weight:600;}
.card-body .brandline{font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;}
.card-body .fromprice{margin-top:auto;padding-top:10px;font-size:13px;color:var(--muted);}
.card-body .fromprice b{color:var(--txt);font-size:16px;}
.card-body .cta{font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-top:8px;color:var(--accent);display:flex;align-items:center;gap:8px;}
.card-body .cta::after{content:'→';transition:transform .3s;}
.card:hover .cta::after{transform:translateX(5px);}

/* ---------- PRODUCT DETAIL MODAL ---------- */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:none;align-items:center;justify-content:center;padding:18px;}
.modal.show{display:flex;animation:fadeIn .25s;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-box{background:#101010;border:1px solid var(--line);width:100%;max-width:860px;max-height:92vh;overflow-y:auto;padding:0;animation:up .3s;}
@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
.pd{display:grid;grid-template-columns:1fr 1fr;}
@media(max-width:700px){.pd{grid-template-columns:1fr;}}
.pd-gallery{background:#0c0c0c;padding:24px;}
.pd-main{aspect-ratio:1;background:#0e0e0e;border:1px solid var(--line);overflow:hidden;position:relative;}
.pd-main img{width:100%;height:100%;object-fit:cover;}
.pd-main .ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:90px;}
.pd-thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}
.pd-thumbs .th{width:62px;height:62px;border:1px solid var(--line);overflow:hidden;cursor:pointer;opacity:.55;transition:.25s;flex-shrink:0;}
.pd-thumbs .th.active,.pd-thumbs .th:hover{opacity:1;border-color:var(--accent);}
.pd-thumbs .th img{width:100%;height:100%;object-fit:cover;}
.pd-info{padding:30px 28px;}
.pd-info .brandline{font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;}
.pd-info h2{font-family:var(--serif);font-size:30px;margin:8px 0 4px;}
.pd-info .desc{color:var(--muted);font-size:14px;line-height:1.7;margin:12px 0 18px;}
.spec-box{border-top:1px solid var(--line);padding:16px 0;}
.spec-box h4{font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;margin-bottom:10px;}
.spec-row{display:flex;justify-content:space-between;font-size:13px;padding:7px 0;border-bottom:1px dashed #1e1e1e;}
.spec-row span{color:var(--muted);}
.variant-list{display:flex;flex-direction:column;gap:2px;margin:6px 0 16px;}
.variant-row{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border:1px solid transparent;cursor:pointer;font-size:14px;transition:.2s;}
.variant-row:hover{background:#161616;}
.variant-row.sel{border-color:var(--accent);background:#161616;}
.variant-row .pr{font-weight:700;}
.variant-row.no{opacity:.35;cursor:not-allowed;}
.pd-actions{display:flex;gap:10px;margin-top:6px;}
.pd-actions .btn{flex:1;}

/* ---------- BUTTONS / FIELDS ---------- */
.btn{background:var(--accent);color:#0b0b0b;border:none;padding:14px 24px;font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:12px;transition:.25s;width:100%;}
.btn:hover{opacity:.88;}
.btn:disabled{background:#333;color:#666;cursor:not-allowed;}
.btn-outline{background:none;color:var(--txt);border:1px solid var(--line);}
.btn-outline:hover{border-color:var(--accent);}
.btn-sm{width:auto;padding:9px 16px;font-size:11px;}
.x-btn{position:sticky;top:0;float:right;margin:14px;background:none;border:1px solid var(--line);color:var(--txt);width:38px;height:38px;border-radius:50%;font-size:15px;z-index:5;}
.x-btn:hover{border-color:var(--accent);}
.field{margin-bottom:14px;}
.field label{display:block;font-size:10px;color:var(--muted);letter-spacing:2px;margin-bottom:6px;text-transform:uppercase;}
.field input,.field textarea,.field select{width:100%;background:#0c0c0c;border:1px solid var(--line);color:var(--txt);padding:12px;font-size:14px;border-radius:0;}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--muted);}

/* ---------- CART DRAWER ---------- */
.drawer{position:fixed;top:0;right:-440px;width:min(440px,100%);height:100%;background:#0e0e0e;border-left:1px solid var(--line);z-index:120;transition:right .35s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;}
.drawer.open{right:0;}
.drawer-head{display:flex;justify-content:space-between;align-items:center;padding:22px;border-bottom:1px solid var(--line);}
.drawer-head h2{font-size:13px;letter-spacing:3px;}
.drawer-body{flex:1;overflow-y:auto;padding:18px 22px;display:flex;flex-direction:column;gap:14px;}
.cart-item{display:flex;gap:12px;border:1px solid var(--line);padding:12px;align-items:center;}
.cart-item img{width:56px;height:56px;object-fit:cover;flex-shrink:0;}
.cart-item .info{flex:1;}
.cart-item .info b{font-size:14px;display:block;}
.cart-item .info small{color:var(--muted);font-size:12px;}
.qty{display:flex;align-items:center;gap:10px;margin-top:8px;}
.qty button{background:none;border:1px solid var(--line);color:var(--txt);width:26px;height:26px;}
.qty button:hover{border-color:var(--accent);}
.drawer-foot{padding:22px;border-top:1px solid var(--line);}
.total-row{display:flex;justify-content:space-between;font-size:17px;font-weight:700;margin-bottom:16px;}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:110;opacity:0;pointer-events:none;transition:.3s;}
.overlay.show{opacity:1;pointer-events:all;}
.pay-note{border:1px dashed var(--line);padding:16px;font-size:13px;color:var(--muted);line-height:1.7;margin:16px 0;}

/* ---------- RECEIPT ---------- */
.receipt{background:#fff;color:#111;padding:26px;font-size:13px;line-height:1.7;}
.receipt h3{text-align:center;letter-spacing:4px;font-family:var(--serif);font-size:18px;}
.receipt hr{border:none;border-top:1px dashed #999;margin:10px 0;}
.receipt .rrow{display:flex;justify-content:space-between;gap:10px;}

/* ---------- ADMIN ---------- */
.modal-pad{padding:28px;}
.tabs{display:flex;gap:8px;margin-bottom:22px;flex-wrap:wrap;}
.tab{background:none;border:1px solid var(--line);color:var(--muted);padding:9px 20px;font-size:11px;letter-spacing:2px;text-transform:uppercase;}
.tab.active{background:var(--accent);color:#0b0b0b;border-color:var(--accent);font-weight:700;}
.admin-table{width:100%;border-collapse:collapse;font-size:13px;}
.admin-table th{text-align:left;color:var(--muted);font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:10px 8px;border-bottom:1px solid var(--line);white-space:nowrap;}
.admin-table td{padding:10px 8px;border-bottom:1px solid #1c1c1c;vertical-align:top;}
.admin-table input,.admin-table select,.admin-table textarea{background:#0c0c0c;border:1px solid var(--line);color:var(--txt);padding:7px;font-size:13px;width:100%;}
.admin-table textarea{resize:vertical;min-height:52px;}
.img-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
.img-chips .chip{position:relative;width:52px;height:52px;}
.img-chips .chip img{width:100%;height:100%;object-fit:cover;}
.img-chips .chip button{position:absolute;top:-6px;right:-6px;background:#000;border:1px solid var(--line);color:#ff7b7b;width:18px;height:18px;font-size:10px;line-height:1;padding:0;}
.up-btn{display:inline-block;border:1px dashed var(--line);padding:8px 14px;font-size:11px;color:var(--muted);cursor:pointer;letter-spacing:1px;}
.up-btn:hover{border-color:var(--accent);color:var(--txt);}

/* ---------- POLICIES / FOOTER ---------- */
.policies details{background:var(--card);border:1px solid var(--line);padding:20px 22px;margin-bottom:12px;}
.policies summary{cursor:pointer;font-weight:600;font-size:14px;letter-spacing:1px;list-style:none;display:flex;justify-content:space-between;align-items:center;}
.policies summary::after{content:'＋';color:var(--muted);}
.policies details[open] summary::after{content:'−';}
.policies p{color:var(--muted);font-size:14px;line-height:1.8;margin-top:14px;}
footer{border-top:1px solid var(--line);text-align:center;padding:44px 24px;color:var(--muted);font-size:12px;line-height:2.2;letter-spacing:1px;}
footer .flogo{font-family:var(--serif);letter-spacing:6px;font-size:18px;color:var(--txt);}
.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(90px);background:var(--accent);color:#0b0b0b;padding:13px 28px;font-weight:700;font-size:13px;letter-spacing:1px;z-index:300;transition:.35s;}
.toast.show{transform:translateX(-50%) translateY(0);}
@media(max-width:640px){
  .nav{padding:15px 18px;}
  .nav-links{gap:16px;}
  .hero{padding:56px 10px 16px;}
  main{padding:0 16px 70px;}
}
</style>
